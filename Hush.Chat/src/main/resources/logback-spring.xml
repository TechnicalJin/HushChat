<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console Appender with custom pattern -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Application loggers -->
    <logger name="com.code.HushChat" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- Spring Framework - reduce noise -->
    <logger name="org.springframework" level="WARN" />
    <logger name="org.springframework.boot" level="WARN" />
    <logger name="org.springframework.web" level="WARN" />
    <logger name="org.springframework.security" level="WARN" />
    <logger name="org.springframework.data" level="WARN" />
    
    <!-- Hibernate - reduce noise -->
    <logger name="org.hibernate" level="ERROR" />
    <logger name="org.hibernate.SQL" level="ERROR" />
    <logger name="org.hibernate.type" level="ERROR" />
    <logger name="org.hibernate.engine" level="ERROR" />
    
    <!-- HikariCP - reduce noise -->
    <logger name="com.zaxxer.hikari" level="WARN" />
    
    <!-- Tomcat - reduce noise -->
    <logger name="org.apache.catalina" level="WARN" />
    <logger name="org.apache.tomcat" level="WARN" />
    
    <!-- Redis - reduce noise -->
    <logger name="org.springframework.data.redis" level="ERROR" />
    <logger name="io.lettuce" level="ERROR" />
    
    <!-- Devtools - reduce noise -->
    <logger name="org.springframework.boot.devtools" level="WARN" />

    <!-- Root logger -->
    <root level="WARN">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
